---
/**
 * 刊头右侧的朱红印章，印着当天的「今日一字」。
 * 构建时先按构建日期填一份，客户端脚本再用访客本地日期改写。
 */
import { dailyInfo } from '../scripts/daily';

interface Props {
  /** 入场动画的序号 */
  index?: number;
}

const info = dailyInfo();
---

<figure class="seal" data-rise style={`--i:${Astro.props.index ?? 1}`}>
  <span class="seal__mark" data-glyph-wrap>
    <span data-glyph>{info.glyph}</span>
  </span>
  <figcaption class="seal__cap">
    <span class="label">今日一字</span>
    <span class="seal__date" data-seal-date>{info.iso}</span>
  </figcaption>
</figure>

<style>
  .seal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    flex: none;
  }

  .seal__mark {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(72px, 8.4vw, 104px);
    aspect-ratio: 1;
    background: var(--red);
    color: var(--paper);
    font-family: var(--font-cjk);
    font-size: clamp(2rem, 2.9vw, 2.6rem);
    line-height: 1;
    box-shadow: inset 0 0 0 4px color-mix(in srgb, var(--paper) 30%, transparent);
    transform: rotate(-1.6deg);
    transition: transform 420ms var(--ease);
    /* 裁掉网点伪元素转出方块的部分，否则会把窄屏撑出横向滚动 */
    overflow: hidden;
    /* 二次落印：红版在纸面上又压了一个偏移的平色影子 */
    filter: drop-shadow(3px 2px 0 color-mix(in srgb, var(--red) 40%, transparent));
  }

  /* 45° 网点：网屏纹理压在红底上、字下面（z-index -1 落在本元素背景之上） */
  .seal__mark::before {
    content: '';
    position: absolute;
    inset: -28%;
    z-index: -1;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--paper) 24%, transparent) 0.75px,
      transparent 1.05px
    );
    background-size: 5px 5px;
    transform: rotate(45deg);
  }

  .seal:hover .seal__mark {
    transform: rotate(0deg);
  }

  .seal__cap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
  }

  .seal__date {
    font-family: var(--font-serif);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .seal__mark {
      width: 64px;
      font-size: 1.9rem;
      box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--paper) 30%, transparent);
    }
  }
</style>
