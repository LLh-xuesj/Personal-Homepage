---
/**
 * 作品栏的一行，排法像书的目录：编号、标题、导点，右边是年份和去处。
 *
 * 一件作品可能有网页和仓库两个入口，所以这一行不再是整行链接：
 * 标题指向第一个入口（通常是网页），右侧单独列出「网页 / 仓库」。
 * 悬停只让标题、序号和入口变朱红——作品是内容，不用导航的压墨手势。
 */
import type { Project } from '../data/site';

interface Props {
  project: Project;
  /** 全局序号，接着入口往下排，会补成 04 */
  n: number;
}

const { project, n } = Astro.props;

const links = [
  { label: '网页', href: project.url },
  { label: '仓库', href: project.repo },
].filter((link) => link.href !== '');

const primary = links[0]?.href;
const meta = [project.role, project.year].filter(Boolean).join(' · ');
---

<li class="work">
  <span class="work__no">{String(n).padStart(2, '0')}</span>

  <span class="work__main">
    <span class="work__line">
      {
        primary ? (
          <a class="work__title" href={primary} target="_blank" rel="noopener">
            {project.title}
          </a>
        ) : (
          <span class="work__title">{project.title}</span>
        )
      }
      <span class="work__leader" aria-hidden="true"></span>
    </span>
    <span class="work__summary">{project.summary}</span>
  </span>

  <span class="work__side">
    {meta !== '' && <span class="work__meta">{meta}</span>}
    {
      links.length > 0 && (
        <span class="work__links">
          {links.map((link) => (
            <a class="work__link" href={link.href} target="_blank" rel="noopener">
              {link.label}
              <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
                <path
                  d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.1"
                />
              </svg>
            </a>
          ))}
        </span>
      )
    }
  </span>
</li>

<style>
  .work {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    align-items: start;
    column-gap: clamp(0.9rem, 2.4vw, 2.2rem);
    padding: clamp(1.05rem, 2.2vw, 1.5rem) 0;
    border-top: 1px solid var(--rule);
  }

  .work__no {
    padding-top: 0.55rem;
    font-family: var(--font-serif);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    transition: color 220ms var(--ease);
  }

  .work:hover .work__no {
    color: var(--red);
  }

  .work__main {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  /* 标题与导点同一条基线，导点吃掉中间的空白 */
  .work__line {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }

  .work__title {
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 2.4vw, 1.95rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    transition: color 220ms var(--ease);
  }

  a.work__title:hover,
  a.work__title:focus-visible {
    color: var(--red);
  }

  .work__leader {
    flex: 1 1 auto;
    min-width: 1.5rem;
    height: 4px;
    transform: translateY(-0.2em);
    background-image: radial-gradient(circle at 1px 2px, var(--rule) 1px, transparent 1.3px);
    background-size: 7px 4px;
    background-repeat: repeat-x;
  }

  .work__summary {
    max-width: 34em;
    font-size: 0.86rem;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .work__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    padding-top: 0.32rem;
  }

  .work__meta {
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .work__links {
    display: flex;
    gap: 0.9rem;
  }

  .work__link {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding-bottom: 1px;
    border-bottom: 1px solid var(--rule);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    white-space: nowrap;
    transition:
      color 200ms var(--ease),
      border-color 200ms var(--ease);
  }

  .work__link:hover,
  .work__link:focus-visible {
    color: var(--red);
    border-color: var(--red);
  }

  @media (max-width: 720px) {
    .work {
      grid-template-columns: 2.4rem minmax(0, 1fr);
      column-gap: 0.7rem;
      padding: 1.05rem 0;
    }

    .work__no {
      padding-top: 0.3rem;
    }

    .work__title {
      font-size: 1.4rem;
    }

    .work__leader {
      display: none;
    }

    .work__side {
      grid-column: 2;
      align-items: flex-start;
      padding-top: 0.45rem;
    }
  }
</style>
