---
/**
 * 固定的版面框：一圈细墨线、四角套准十字、右缘一把阅读刻度尺。
 * 全部是装饰，pointer-events: none，不挡任何链接。
 */
---

<div class="frame" aria-hidden="true">
  <span class="frame__c frame__c--tl"></span>
  <span class="frame__c frame__c--tr"></span>
  <span class="frame__c frame__c--bl"></span>
  <span class="frame__c frame__c--br"></span>
  <div class="frame__bar">
    <span class="frame__dot" data-progress-dot></span>
  </div>
</div>

<style>
  .frame {
    position: fixed;
    inset: 11px;
    z-index: 40;
    border: 1px solid var(--rule);
    pointer-events: none;
  }

  .frame__c {
    position: absolute;
    width: 11px;
    height: 11px;
  }

  .frame__c::before,
  .frame__c::after {
    content: '';
    position: absolute;
    background: var(--red);
  }

  .frame__c::before {
    top: 5px;
    left: 0;
    width: 11px;
    height: 1px;
  }

  .frame__c::after {
    top: 0;
    left: 5px;
    width: 1px;
    height: 11px;
  }

  .frame__c--tl {
    top: -6px;
    left: -6px;
  }

  .frame__c--tr {
    top: -6px;
    right: -6px;
  }

  .frame__c--bl {
    bottom: -6px;
    left: -6px;
  }

  .frame__c--br {
    right: -6px;
    bottom: -6px;
  }

  /* 刻度尺：每 13px 一格细刻度，红点在上面滑 */
  .frame__bar {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 3px;
    background:
      repeating-linear-gradient(to bottom, var(--rule) 0 1px, transparent 1px 13px),
      color-mix(in srgb, var(--ink) 5%, transparent);
  }

  .frame__dot {
    position: absolute;
    top: 0;
    right: -2px;
    width: 7px;
    height: 7px;
    background: var(--red);
    transform: translateY(0);
    will-change: transform;
  }

  @media (max-width: 640px) {
    .frame {
      inset: 7px;
    }

    .frame__bar {
      width: 2px;
    }

    .frame__dot {
      width: 6px;
      height: 6px;
    }
  }
</style>
