---
/**
 * 目录里的一行。整行是一个链接：
 * 悬停或键盘聚焦时，墨色从左往右压满整行，字翻成纸色。
 */
import type { Entry } from '../data/site';

interface Props {
  entry: Entry;
  /** 从 1 开始的序号，会补成 01 */
  n: number;
}

const { entry, n } = Astro.props;
---

<li class="row-item">
  <a
    class="row"
    href={entry.href}
    rel={entry.external ? 'noopener' : undefined}
    target={entry.external ? '_blank' : undefined}
  >
    <span class="row__n">{String(n).padStart(2, '0')}</span>
    <span class="row__label">{entry.label}</span>
    <span class="row__note">{entry.note}</span>
    <span class="row__arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
        <path d="M5.5 18.5 18.5 5.5M9 5.5h9.5V15" fill="none" stroke="currentColor" stroke-width="1.3"></path>
      </svg>
    </span>
  </a>
</li>

<style>
  .row-item {
    border-top: 1px solid var(--rule);
  }

  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1.1fr) minmax(0, 1fr) 2.2rem;
    align-items: center;
    gap: clamp(0.9rem, 2.4vw, 2.2rem);
    padding: clamp(1.2rem, 2.5vw, 1.8rem) 0;
    transition: color 200ms var(--ease);
  }

  /* 墨色从左侧压过来；左右各溢出一小截，像印版出血 */
  .row::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--pad) * -0.3);
    z-index: -1;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 440ms var(--ease);
  }

  .row:hover::before,
  .row:focus-visible::before {
    transform: scaleX(1);
  }

  .row:hover,
  .row:focus-visible {
    color: var(--paper);
  }

  .row__n {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    transition: color 200ms var(--ease);
  }

  .row__label {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.3vw, 2.7rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .row__note {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 24em;
    transition: color 200ms var(--ease);
  }

  .row:hover .row__n,
  .row:focus-visible .row__n {
    color: color-mix(in srgb, var(--paper) 62%, transparent);
  }

  .row:hover .row__note,
  .row:focus-visible .row__note {
    color: color-mix(in srgb, var(--paper) 80%, transparent);
  }

  .row__arrow {
    justify-self: end;
    color: var(--red);
    transition:
      transform 300ms var(--ease),
      color 200ms var(--ease);
  }

  .row:hover .row__arrow,
  .row:focus-visible .row__arrow {
    transform: translate(4px, -4px);
    color: var(--paper);
  }

  @media (max-height: 800px) and (min-width: 721px) {
    .row {
      padding: 1.35rem 0;
    }
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 2.4rem minmax(0, 1fr) 1.5rem;
      grid-template-areas:
        'n label arrow'
        'n note arrow';
      align-items: start;
      gap: 0.1rem 0.7rem;
    }

    .row__n {
      grid-area: n;
      padding-top: 0.5rem;
    }

    .row__label {
      grid-area: label;
    }

    .row__note {
      grid-area: note;
      font-size: 0.85rem;
      padding-top: 0.35rem;
    }

    .row__arrow {
      grid-area: arrow;
      padding-top: 0.5rem;
    }
  }
</style>
